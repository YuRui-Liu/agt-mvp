<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>投递职位：Z · 快手校园招聘</title>
  <style>
    :root{--orange:#ff6b12;--orange-deep:#ed5610;--ink:#282522;--muted:#817a74;--line:#e8e5e2;--paper:#fff;--canvas:#fafafa;--soft:#fff6ef;--green:#27875e;--purple:#6043c8}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;color:var(--ink);background:var(--canvas);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px}button,input,select{font:inherit}button{border:0}a{text-decoration:none;color:inherit}
    .topnav{height:82px;padding:0 40px;display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid #eee;box-shadow:0 4px 18px rgba(30,20,10,.04);position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:12px}.brand-mark{width:36px;height:36px;border-radius:11px;background:#ff6b32;display:grid;grid-template-columns:repeat(2,7px);grid-template-rows:repeat(2,10px);gap:3px;place-content:center;box-shadow:0 5px 12px rgba(255,107,18,.25)}.brand-mark i{display:block;border-radius:50%;background:#fff}.brand-copy{display:flex;align-items:center;gap:14px}.brand-copy strong{font-size:22px;font-weight:850;letter-spacing:-.06em}.brand-copy span{padding-left:14px;border-left:1px solid #d9d5d2;color:#a09b97;font-size:22px;letter-spacing:.04em}.nav-links{display:flex;align-items:center;gap:44px;height:100%;font-size:16px}.nav-links a{height:100%;display:flex;align-items:center;position:relative;color:#37332f}.nav-links a.active{font-weight:800}.nav-links a.active::after{position:absolute;right:0;bottom:0;left:0;height:4px;border-radius:4px 4px 0 0;background:var(--orange);content:""}.nav-user{color:#85817e;font-size:13px}
    .page{width:min(1400px,100%);margin:0 auto;padding:62px 50px 130px;display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:68px;background:#fff}.content{min-width:0}.page-title{margin:0 0 84px;font-size:36px;letter-spacing:-.05em}.section{padding:0 0 38px;margin-bottom:38px;border-bottom:1px solid #eee}.section:last-child{margin-bottom:0}.section-head{display:flex;align-items:center;gap:18px;margin-bottom:28px}.section-head::before{width:5px;height:32px;border-radius:3px;background:var(--orange);content:""}.section-head h2{margin:0;font-size:24px;letter-spacing:-.04em}.section-label{margin:0 0 18px;font-size:15px;font-weight:800}.section-label .required{color:var(--orange);margin-left:4px}
    .form-grid{display:grid;grid-template-columns:140px minmax(0,1fr);column-gap:28px;row-gap:18px;align-items:start}.field-label{padding-top:13px;font-weight:700;color:#35312e}.input,.select{width:100%;height:50px;padding:0 16px;border:1px solid #ddd9d6;border-radius:6px;outline:none;color:#36312e;background:#fff}.input::placeholder{color:#c2bdb8}.input:focus,.select:focus{border-color:#f2a06e;box-shadow:0 0 0 3px #fff0e5}.select{appearance:none;background:linear-gradient(45deg,transparent 50%,#aaa 50%) calc(100% - 18px) 22px/8px 8px no-repeat,linear-gradient(135deg,#aaa 50%,transparent 50%) calc(100% - 12px) 22px/8px 8px no-repeat,#fff}
    .aiti-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:start}.aiti-actions{display:flex;gap:10px}.verify-button,.assessment-link{height:50px;padding:0 18px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;font-size:13px;font-weight:800;cursor:pointer}.verify-button{color:var(--orange-deep);background:var(--soft);border:1px solid #f8c8a7}.verify-button:hover{background:#ffeadb}.assessment-link{color:#fff;background:linear-gradient(135deg,#7c60df,#5637b8);box-shadow:0 8px 18px rgba(88,54,184,.16)}.field-help{margin:8px 0 0;color:#aaa49f;font-size:12px;line-height:1.65}.field-help strong{color:#a09a94}.status{min-height:18px;margin:9px 0 0;color:var(--orange-deep);font-size:12px;font-weight:700}.status.success{color:var(--green)}
    .upload{min-height:300px;padding:46px 20px;display:grid;place-items:center;border:1px solid #f1f1f1;background:#fff;text-align:center}.upload-title{font-size:24px;font-weight:800}.upload-button{display:inline-flex;align-items:center;gap:8px;height:52px;margin-top:24px;padding:0 28px;border:2px solid #ff7a38;border-radius:30px;color:var(--orange);background:#fff;cursor:pointer;font-size:16px;font-weight:800}.upload-button:hover{background:var(--soft)}.upload-note{margin-top:25px;color:#aaa49f;font-size:13px}.upload input{display:none}.file-name{min-height:20px;margin-top:12px;color:var(--green);font-size:12px}
    .basic-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 28px}.basic-field{display:grid;gap:9px}.basic-field label{font-weight:700}.inline-actions{display:flex;gap:12px;align-items:center}
    .application-sidebar{position:sticky;top:130px;height:max-content;padding-top:3px}.sidebar-title{display:flex;align-items:center;gap:16px;margin-bottom:24px;color:var(--orange);font-size:20px;font-weight:850}.sidebar-title::before{width:5px;height:36px;border-radius:3px;background:var(--orange);content:""}.sidebar-nav{display:grid;gap:23px;padding-left:30px}.sidebar-nav a{color:#393532;font-size:16px}.sidebar-nav a:hover,.sidebar-nav a.active{color:var(--orange);font-weight:800}.sidebar-nav a.active{position:relative}.sidebar-nav a.active::before{position:absolute;left:-30px;top:4px;width:5px;height:18px;border-radius:4px;background:var(--orange);content:""}
    .toast{position:fixed;left:50%;bottom:105px;z-index:50;max-width:calc(100% - 32px);padding:12px 18px;border-radius:8px;color:#fff;background:rgba(40,35,30,.92);box-shadow:0 12px 28px rgba(20,10,0,.2);opacity:0;pointer-events:none;transform:translate(-50%,10px);transition:opacity .18s,transform .18s;font-size:13px}.toast.show{opacity:1;transform:translate(-50%,0)}.application-footer{position:fixed;right:0;bottom:0;left:0;z-index:30;height:92px;padding:18px 50px;display:flex;justify-content:center;align-items:center;gap:32px;background:rgba(255,255,255,.95);border-top:1px solid #eee;box-shadow:0 -5px 20px rgba(20,10,0,.04);backdrop-filter:blur(10px)}.footer-button{width:245px;height:54px;border-radius:28px;cursor:pointer;font-size:18px;font-weight:800}.footer-button.cancel{color:#615c58;background:#fff;border:1px solid #ded9d5}.footer-button.submit{color:#fff;background:linear-gradient(135deg,#ff7c3d,#ed5610);box-shadow:0 10px 22px rgba(237,86,16,.22)}.footer-button.submit:disabled{opacity:.65;cursor:not-allowed}
    @media(max-width:1050px){.topnav{padding:0 24px}.nav-links{gap:22px}.brand-copy span{font-size:17px}.page{padding:48px 28px 130px;gap:35px}.application-sidebar{width:210px}.form-grid{grid-template-columns:110px minmax(0,1fr)}}
    @media(max-width:760px){.topnav{height:68px;padding:0 16px}.brand-copy strong{font-size:18px}.brand-copy span,.nav-links,.nav-user{display:none}.page{display:block;padding:34px 18px 125px}.page-title{margin-bottom:48px;font-size:30px}.application-sidebar{display:none}.section-head h2{font-size:21px}.form-grid{grid-template-columns:1fr;gap:8px}.field-label{padding-top:0}.aiti-row{grid-template-columns:1fr}.aiti-actions{flex-wrap:wrap}.assessment-link,.verify-button{width:100%}.basic-grid{grid-template-columns:1fr}.application-footer{height:78px;padding:12px 16px;gap:10px}.footer-button{height:50px;width:50%;font-size:16px}}
  </style>
</head>
<body>
  <header class="topnav">
    <a class="brand" href="{{RETURN_URL}}" aria-label="返回职位列表">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="brand-copy"><strong>快手</strong><span>校园招聘</span></span>
    </a>
    <nav class="nav-links" aria-label="校园招聘导航">
      <a href="{{RETURN_URL}}">首页</a><a href="#">快Star人才计划</a><a class="active" href="{{RETURN_URL}}">应届招聘</a><a href="#">实习招聘</a><a href="#">校招动态</a><a href="#">探索快手</a>
    </nav>
    <span class="nav-user">121****1130 ▾</span>
  </header>

  <main class="page">
    <div class="content">
      <h1 class="page-title">投递职位：Z</h1>

      <section class="section" id="recommend" aria-labelledby="recommend-title">
        <div class="section-head"><h2 id="recommend-title">推荐信息</h2></div>
        <div class="form-grid">
          <label class="field-label" for="recommendCode">推荐码</label>
          <input class="input" id="recommendCode" placeholder="请输入推荐码" />
          <label class="field-label" for="aitiIdInput">AITI ID</label>
          <div>
            <div class="aiti-row"><input class="input" id="aitiIdInput" maxlength="6" placeholder="请输入 6 位数字+英文组合" /><div class="aiti-actions"><button class="verify-button" id="verifyButton" type="button">↻</button><a class="assessment-link" href="ai-assessment-entry.html">点击跳转 AI 能力测评</a></div></div>
            <p class="field-help">💡 AITI 测评结果可作为应聘评估的参考依据，有助于推进应聘流程、加速简历筛选并优先安排面试。测评完全自愿，不影响基本应聘资格。</p>
            <p class="status" id="aitiStatus" role="status" aria-live="polite"></p>
          </div>
        </div>
      </section>

      <section class="section" id="location" aria-labelledby="location-title">
        <div class="section-head"><h2 id="location-title">意向选择</h2></div>
        <div class="form-grid">
          <label class="field-label" for="locationSelect">意向地点<span class="required">*</span></label>
          <select class="select" id="locationSelect"><option value="">请选择意向地点</option><option>北京</option><option>上海</option><option>无锡</option><option>杭州</option></select>
        </div>
      </section>

      <section class="section" id="resume" aria-labelledby="resume-title">
        <div class="section-head"><h2 id="resume-title">附件简历</h2></div>
        <div class="upload">
          <div><div class="upload-title">请上传您的简历</div><label class="upload-button" for="resumeInput">↥ 上传简历</label><input id="resumeInput" type="file" accept=".doc,.docx,.pdf,.png" /><div class="file-name" id="fileName"></div><div class="upload-note">支持 word、pdf、png 等格式文件，文件大小需小于 20M</div></div>
        </div>
      </section>

      <section class="section" id="basic" aria-labelledby="basic-title">
        <div class="section-head"><h2 id="basic-title">基本信息</h2></div>
        <div class="basic-grid"><div class="basic-field"><label for="name">姓名<span class="required">*</span></label><input class="input" id="name" placeholder="请输入姓名" /></div><div class="basic-field"><label for="phone">手机号<span class="required">*</span></label><input class="input" id="phone" placeholder="请输入手机号" /></div><div class="basic-field"><label for="email">邮箱<span class="required">*</span></label><input class="input" id="email" placeholder="请输入邮箱" /></div><div class="basic-field"><label for="school">学校</label><input class="input" id="school" placeholder="请输入学校" /></div></div>
      </section>

      <section class="section" id="education" aria-labelledby="education-title"><div class="section-head"><h2 id="education-title">教育经历</h2></div><div class="basic-grid"><div class="basic-field"><label>学历</label><select class="select"><option>本科</option><option>硕士</option><option>博士</option></select></div><div class="basic-field"><label>毕业时间</label><input class="input" placeholder="请选择毕业时间" /></div></div></section>
      <section class="section" id="experience" aria-labelledby="experience-title"><div class="section-head"><h2 id="experience-title">实习经历</h2></div><input class="input" placeholder="请输入实习经历（Mock）" /></section>
      <section class="section" id="project" aria-labelledby="project-title"><div class="section-head"><h2 id="project-title">项目经历</h2></div><input class="input" placeholder="请输入项目经历（Mock）" /></section>
      <section class="section" id="skills" aria-labelledby="skills-title"><div class="section-head"><h2 id="skills-title">语言能力与 IT 技能</h2></div><div class="basic-grid"><input class="input" placeholder="语言能力（Mock）" /><input class="input" placeholder="IT 技能（Mock）" /></div></section>
    </div>

    <aside class="application-sidebar" aria-label="投递信息导航">
      <div class="sidebar-title">投递信息</div>
      <nav class="sidebar-nav"><a class="active" href="#resume">附件简历</a><a href="#basic">基本信息<span class="required">*</span></a><a href="#education">教育经历<span class="required">*</span></a><a href="#experience">实习经历</a><a href="#project">项目经历</a><a href="#skills">论文</a><a href="#skills">语言能力</a><a href="#skills">IT 技能</a><a href="#skills">技能证书</a><a href="#skills">竞赛获奖</a><a href="#skills">其他荣誉</a><a href="#skills">作品信息</a><a href="#skills">其他附件</a></nav>
    </aside>
  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <footer class="application-footer"><button class="footer-button cancel" type="button" id="cancelApplication">取消</button><button class="footer-button submit" id="submitApplication" type="button">投递简历</button></footer>

  <script>{{AITI_MOCK_JS}}</script>
  <script>
    const aitiIdInput = document.getElementById('aitiIdInput');
    const aitiStatus = document.getElementById('aitiStatus');
    const toast = document.getElementById('toast');

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add('show');
      window.clearTimeout(window.__aitiToastTimer);
      window.__aitiToastTimer = window.setTimeout(() => toast.classList.remove('show'), 2300);
    }

    function setStatus(message, success) {
      aitiStatus.textContent = message;
      aitiStatus.classList.toggle('success', Boolean(success));
    }

    function validateAitiId() {
      const value = aitiIdInput.value.trim().toUpperCase();
      if (!window.AITIMock.validateId(value)) {
        setStatus('请输入 6 位数字+英文组合的 AITI ID');
        return null;
      }
      const lookup = window.AITIMock.lookupId(value);
      if (lookup.status === 'missing') {
        setStatus('当前无此ID，请生成唯一ID后提交！');
        return null;
      }
      if (lookup.status === 'associated') {
        setStatus('当前已经关联过其他应聘记录，请更换后重新提交');
        return null;
      }
      return value;
    }

    document.getElementById('verifyButton').addEventListener('click', validateAitiId);
    aitiIdInput.addEventListener('blur', validateAitiId);
    document.getElementById('resumeInput').addEventListener('change', (event) => {
      const file = event.target.files[0];
      document.getElementById('fileName').textContent = file ? `已选择：${file.name}` : '';
    });

    const availableId = [...window.AITIMock.getState().ids].reverse().find((item) => !item.associated);
    if (availableId) aitiIdInput.value = availableId.value;

    document.getElementById('cancelApplication').addEventListener('click', () => {
      window.location.href = '{{RETURN_URL}}';
    });

    let submitting = false;
    document.getElementById('submitApplication').addEventListener('click', () => {
      if (submitting) return;
      if (!document.getElementById('locationSelect').value) {
        showToast('请先选择意向地点');
        document.getElementById('locationSelect').focus();
        return;
      }
      if (!document.getElementById('resumeInput').files[0]) {
        showToast('请先上传简历');
        return;
      }
      const required = [
        ['name', '请输入姓名'],
        ['phone', '请输入手机号'],
        ['email', '请输入邮箱'],
      ];
      for (const [id, message] of required) {
        const field = document.getElementById(id);
        if (!field.value.trim()) {
          showToast(message);
          field.focus();
          return;
        }
      }
      if (!/^1[3-9]\d{9}$/.test(document.getElementById('phone').value.trim())) {
        showToast('请输入正确的手机号');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(document.getElementById('email').value.trim())) {
        showToast('请输入正确的邮箱');
        return;
      }
      const value = validateAitiId();
      if (!value) return;
      submitting = true;
      try {
        window.AITIMock.createApplication(value, 'Z');
        document.getElementById('submitApplication').disabled = true;
        document.getElementById('submitApplication').textContent = '已完成投递';
        showToast('投递成功');
      } catch (error) {
        submitting = false;
        setStatus(error && error.message ? error.message : '投递失败，请重试');
      }
    });
  </script>
</body>
</html>
